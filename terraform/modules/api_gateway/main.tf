resource "aws_apigatewayv2_api" "this" {
  name          = "${var.prefix}-http-api"
  protocol_type = "HTTP"

  cors_configuration {
    allow_origins = ["*"]
    allow_methods = ["GET", "POST", "PUT", "DELETE", "OPTIONS"]
    allow_headers = ["Content-Type", "Authorization", "X-Amz-Date", "X-Api-Key", "X-Amz-Security-Token"]
    max_age       = 300
  }
}

resource "aws_apigatewayv2_stage" "default" {
  api_id      = aws_apigatewayv2_api.this.id
  name        = "$default"
  auto_deploy = true
}

resource "aws_apigatewayv2_integration" "parse_cobol" {
  api_id                 = aws_apigatewayv2_api.this.id
  integration_type       = "AWS_PROXY"
  integration_uri        = var.parse_cobol_invoke_arn
  payload_format_version = "2.0"
}

resource "aws_apigatewayv2_route" "parse" {
  api_id    = aws_apigatewayv2_api.this.id
  route_key = "POST /parse"
  target    = "integrations/${aws_apigatewayv2_integration.parse_cobol.id}"
}

resource "aws_lambda_permission" "parse_cobol" {
  statement_id  = "AllowAPIGWInvoke"
  action        = "lambda:InvokeFunction"
  function_name = var.parse_cobol_function_name
  principal     = "apigateway.amazonaws.com"
  source_arn    = "${aws_apigatewayv2_api.this.execution_arn}/*/*/parse"
}

resource "terraform_data" "write_env_local" {
  depends_on = [aws_apigatewayv2_stage.default]

  triggers_replace = [aws_apigatewayv2_api.this.api_endpoint]

  provisioner "local-exec" {
    interpreter = ["PowerShell", "-Command"]
    command     = <<-EOT
      $content = @"
# Auto-generated by Terraform — do not edit manually
VITE_API_URL=${aws_apigatewayv2_api.this.api_endpoint}
VITE_WS_URL=
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
"@
      $content | Out-File -FilePath "${var.env_local_path}" -Encoding utf8
      Write-Host "Written ${var.env_local_path}"
      Write-Host "  VITE_API_URL=${aws_apigatewayv2_api.this.api_endpoint}"
    EOT
  }
}
